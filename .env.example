# ===================================================================
# 환경변수 템플릿 파일
# -------------------------------------------------------------------
# 사용법:
#   1. 이 파일을 복사해서 이름을 .env 로 바꾼다
#        Windows PowerShell:  Copy-Item .env.example .env
#   2. 아래 GOOGLE_API_KEY= 뒤에 본인의 실제 API 키를 붙여넣는다
#   3. .env 파일은 .gitignore에 등록되어 있어 절대 커밋되지 않는다
#
# API 키 발급:
#   https://aistudio.google.com/ 접속 → 로그인
#   → "Get API key" → "Create API key"
# ===================================================================

# Google AI Studio에서 발급받은 Gemini API 키 (필수)
GOOGLE_API_KEY=여기에_본인의_API_키를_붙여넣으세요

# 사용할 Gemini 모델 이름 (선택, 비워두면 기본값 gemini-2.0-flash 사용)
GEMINI_MODEL=gemini-2.0-flash
